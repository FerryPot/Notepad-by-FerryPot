<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NotepadByFerryPot</RootNamespace>
    <ApplicationTitle>Notepad by FerryPot</ApplicationTitle>
    <Product>Notepad by FerryPot</Product>
    <Title>Notepad by FerryPot</Title>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>FerryPot</Authors>
    <Company>FerryPot</Company>
    <Copyright>Copyright (c) 2026 [YOUR NAME]</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <BuildChannel Condition="'$(BuildChannel)' == ''">Stable</BuildChannel>
  </PropertyGroup>

  <!-- Channel-specific settings -->
  <PropertyGroup Condition="'$(BuildChannel)' == 'Features' Or '$(BuildChannel)' == 'features'">
    <AssemblyName>NotepadByFerryPot-features</AssemblyName>
    <DefineConstants>$(DefineConstants);CHANNEL_FEATURES</DefineConstants>
    <VersionSuffix>features</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildChannel)' == 'AI' Or '$(BuildChannel)' == 'ai' Or '$(BuildChannel)' == 'Ai'">
    <AssemblyName>NotepadByFerryPot-ai</AssemblyName>
    <DefineConstants>$(DefineConstants);CHANNEL_AI</DefineConstants>
    <VersionSuffix>ai</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildChannel)' != 'Features' And '$(BuildChannel)' != 'features' And '$(BuildChannel)' != 'AI' And '$(BuildChannel)' != 'ai' And '$(BuildChannel)' != 'Ai'">
    <AssemblyName>NotepadByFerryPot</AssemblyName>
    <DefineConstants>$(DefineConstants);CHANNEL_STABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="5.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
  </ItemGroup>

</Project>
