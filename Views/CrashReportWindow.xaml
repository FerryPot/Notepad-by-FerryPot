<Window x:Class="NotepadByFerryPot.Views.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Notepad by FerryPot - Error" 
        Icon="../Assets/app.ico"
        Width="480" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="AlertCircle" Width="36" Height="36" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Something went wrong" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text="An unexpected error occurred in the application." FontSize="13" Opacity="0.75" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Crash diagnostic details have been recorded to the following log file:" 
                   TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13"/>

        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <TextBox x:Name="LogFilePathBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" 
                     Background="Transparent" FontSize="11" FontFamily="Consolas"/>
        </Border>

        <TextBlock Grid.Row="3" x:Name="CopyStatusText" Text="" Foreground="#43A047" FontWeight="SemiBold" 
                   HorizontalAlignment="Left" Margin="0,0,0,16" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="COPY DETAILS" 
                    Click="CopyDetails_Click" 
                    Margin="0,0,8,0" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="CLOSE" 
                    Click="Close_Click" 
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
