<Window x:Class="NotepadByFerryPot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings — Notepad By FerryPot"
        Icon="../Assets/app.ico"
        Height="540" Width="750"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Navigation (Width 210) -->
            <ColumnDefinition Width="210"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0"
                Padding="12,20,12,16">
            <DockPanel LastChildFill="True">
                <!-- App Title in Sidebar -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="../Assets/app.png" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" 
                                   FontWeight="Bold" 
                                   FontSize="20" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Notepad By FerryPot" 
                               FontSize="12" 
                               Opacity="0.6" 
                               Margin="32,2,0,0"/>
                </StackPanel>

                <!-- Navigation ListBox -->
                <ListBox x:Name="NavigationListBox" 
                         SelectionChanged="NavigationListBox_SelectionChanged"
                         SelectedIndex="0"
                         Style="{StaticResource MaterialDesignNavigationListBox}">
                    <ListBoxItem x:Name="NavItemAppearance" Padding="12,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Appearance" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="NavItemTypography" Padding="12,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatSize" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Typography" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="NavItemEditor" Padding="12,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Editor" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="NavItemAbout" Padding="12,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Content Pages -->
        <Grid Grid.Column="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page 1: Appearance -->
            <ScrollViewer Grid.Row="0" x:Name="PageAppearance" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Customize how the application looks and adapts to your environment." Opacity="0.65" Margin="0,0,0,24"/>

                    <!-- Theme Mode Card -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="THEME MODE" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystemRadio" Content="System Default" Margin="0,0,24,0" Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeLightRadio" Content="Light" Margin="0,0,24,0" Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="ThemeDarkRadio" Content="Dark" Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Display Options Card -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="DISPLAY OPTIONS" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,12"/>
                            
                            <CheckBox x:Name="AmoledCheckBox" 
                                      Content="OLED Pure Black Dark Mode (AMOLED #000000)" 
                                      Margin="0,0,0,12"
                                      Checked="SettingChanged" 
                                      Unchecked="SettingChanged"/>

                            <CheckBox x:Name="StatusBarCheckBox" 
                                      Content="Show Status Bar at bottom of window" 
                                      Checked="SettingChanged" 
                                      Unchecked="SettingChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 2: Typography -->
            <ScrollViewer Grid.Row="0" x:Name="PageTypography" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Typography" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Select font families, sizing, and text formatting." Opacity="0.65" Margin="0,0,0,24"/>

                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Font Family -->
                            <TextBlock Text="FONT FAMILY" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FontFamilyComboBox" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,16" 
                                      SelectionChanged="FontFamilyComboBox_SelectionChanged"/>

                            <!-- Font Size -->
                            <TextBlock Text="FONT SIZE" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock x:Name="FontSizeValueText" Text="15 pt" Width="60" DockPanel.Dock="Right" TextAlignment="Right" FontWeight="Bold"/>
                                <Slider x:Name="FontSizeSlider" 
                                        Minimum="10" Maximum="36" Value="15" 
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="FontSizeSlider_ValueChanged"/>
                            </DockPanel>

                            <!-- Font Weight -->
                            <TextBlock Text="FONT WEIGHT" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FontWeightComboBox" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      SelectionChanged="SettingChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Preview -->
                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="LIVE PREVIEW" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,12"/>
                            <Border Background="{DynamicResource MaterialDesignPaper}" 
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1" CornerRadius="8" Padding="16">
                                <TextBlock x:Name="PreviewTextBlock" 
                                           Text="The quick brown fox jumps over the lazy dog. 1234567890 /* Material 3 */" 
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 3: Editor -->
            <ScrollViewer Grid.Row="0" x:Name="PageEditor" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Editor Behavior" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure text editing aids, indentation, and formatting preferences." Opacity="0.65" Margin="0,0,0,24"/>

                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <CheckBox x:Name="WordWrapCheckBox" 
                                      Content="Word wrap long lines" 
                                      Margin="0,0,0,12"
                                      Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox x:Name="LineNumbersCheckBox" 
                                      Content="Show line numbers in gutter" 
                                      Margin="0,0,0,12"
                                      Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox x:Name="AutoIndentCheckBox" 
                                      Content="Auto-indent on Enter (match previous line)" 
                                      Margin="0,0,0,12"
                                      Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox x:Name="AutoCloseBracketsCheckBox" 
                                      Content="Auto-close brackets and quotes ( ) [ ] { } &quot; &quot; ' '" 
                                      Margin="0,0,12,12"
                                      Checked="SettingChanged" Unchecked="SettingChanged"/>
                            <CheckBox x:Name="UseSpacesForTabCheckBox" 
                                      Content="Insert spaces when pressing Tab key" 
                                      Margin="0,0,0,16"
                                      Checked="SettingChanged" Unchecked="SettingChanged"/>

                            <Separator Margin="0,0,0,16"/>

                            <TextBlock Text="TAB INDENT SIZE" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="TabSizeComboBox" 
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Width="200" HorizontalAlignment="Left"
                                      SelectionChanged="SettingChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 4: About -->
            <ScrollViewer Grid.Row="0" x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Application information and shortcuts." Opacity="0.65" Margin="0,0,0,24"/>

                    <Border Background="{DynamicResource MaterialDesignCardBackground}" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Image Source="../Assets/app.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Notepad By FerryPot" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Version 1.0 (Windows Native x64)" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <TextBlock Text="A modern, high-performance Windows text editor built with official Google Material Design 3 (M3) stock components and smooth multi-tab editing." 
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Separator Margin="0,0,0,16"/>

                            <TextBlock Text="CORE FEATURES" Style="{StaticResource MaterialDesignOverlineTextBlock}" Margin="0,0,0,8"/>
                            <TextBlock Text="• Multi-tab document workspace with close protection" Margin="8,2,0,0"/>
                            <TextBlock Text="• Full modeless Find &amp; Replace with case and whole-word matching" Margin="8,2,0,0"/>
                            <TextBlock Text="• Smart auto-indent and bracket auto-pairing" Margin="8,2,0,0"/>
                            <TextBlock Text="• Synchronized smooth line numbering" Margin="8,2,0,0"/>
                            <TextBlock Text="• Real-time word, character, and line counter" Margin="8,2,0,0"/>
                            <TextBlock Text="• Drag-and-drop file opening" Margin="8,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" 
                        Content="DONE" 
                        Width="110"
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Click="Done_Click"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
