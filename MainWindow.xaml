<Window x:Class="NotepadByFerryPot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:NotepadByFerryPot.Controls"
        Title="Notepad By FerryPot" 
        Icon="Assets/app.ico"
        Height="720" Width="1080"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar / Menu (Row 0) -->
            <RowDefinition Height="Auto" x:Name="TopAppBarRow"/>
            <!-- Tabs Bar (Row 1) -->
            <RowDefinition Height="Auto" x:Name="TabsBarRow"/>
            <!-- Editor Body (Row 2) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar (Row 3) -->
            <RowDefinition Height="Auto" x:Name="StatusBarRow"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="8,4">
                <!-- Action Buttons on Right -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            ToolTip="Find &amp; Replace (Ctrl+F)"
                            Click="Find_Click">
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            ToolTip="Document Statistics"
                            Click="Stats_Click">
                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            ToolTip="Focus / Zen Mode (F11)"
                            Click="FocusMode_Click">
                        <materialDesign:PackIcon Kind="Fullscreen" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                            ToolTip="Open Settings (Ctrl+,)"
                            Height="32" Padding="10,0"
                            Margin="4,0,0,0"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center" FontWeight="Medium" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Menus & Brand on Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Title / Brand -->
                    <StackPanel Orientation="Horizontal" Margin="4,0,16,0" VerticalAlignment="Center">
                        <Image Source="Assets/app.png" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Notepad" 
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" by FerryPot" 
                                   FontSize="13" 
                                   Opacity="0.6" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Menu Bar -->
                    <Menu Background="Transparent">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New Tab" InputGestureText="Ctrl+N" Click="NewTab_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Plus" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenFile_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAsFile_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentSaveEditOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Print..." InputGestureText="Ctrl+P" Click="Print_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PrinterOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                            <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
                        </MenuItem>

                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Redo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="Cut_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCut" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="Paste_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentPaste" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Time/_Date" InputGestureText="F5" Click="InsertTimeDate_Click"/>
                        </MenuItem>

                        <MenuItem Header="_View">
                            <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                            <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                            <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="ResetZoom_Click"/>
                            <Separator/>
                            <MenuItem Header="_Word Wrap" x:Name="WordWrapMenuItem" IsCheckable="True" Click="WordWrap_Toggle"/>
                            <MenuItem Header="_Line Numbers" x:Name="LineNumbersMenuItem" IsCheckable="True" Click="LineNumbers_Toggle"/>
                            <MenuItem Header="_Status Bar" x:Name="StatusBarMenuItem" IsCheckable="True" Click="StatusBar_Toggle"/>
                            <Separator/>
                            <MenuItem Header="_Focus / Zen Mode" InputGestureText="F11" Click="FocusMode_Click"/>
                        </MenuItem>

                        <MenuItem Header="_Tools">
                            <MenuItem Header="_Document Statistics" Click="Stats_Click"/>
                            <Separator/>
                            <MenuItem Header="Line Endings">
                                <MenuItem Header="Windows (CRLF)" Click="SetCRLF_Click"/>
                                <MenuItem Header="Unix (LF)" Click="SetLF_Click"/>
                            </MenuItem>
                            <MenuItem Header="Encoding">
                                <MenuItem Header="UTF-8" Click="SetEncodingUTF8_Click"/>
                                <MenuItem Header="UTF-16 LE" Click="SetEncodingUTF16_Click"/>
                                <MenuItem Header="ASCII" Click="SetEncodingASCII_Click"/>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="_Settings" InputGestureText="Ctrl+," Click="Settings_Click">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="CogOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tabs Bar -->
        <Border Grid.Row="1" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1"
                Padding="6,4,6,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" x:Name="TabsStackPanel">
                    <!-- Dynamic Tabs Rendered Here -->
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            ToolTip="New Document (Ctrl+N)"
                            Margin="4,0,0,4"
                            Width="32" Height="32"
                            Click="NewTab_Click">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Editor Content Area -->
        <controls:NotepadEditor Grid.Row="2" x:Name="ActiveEditor" />

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="16,4">
            <DockPanel LastChildFill="True">
                <!-- Right Side: Zoom, Line Ending, Encoding -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomStatusText" 
                               Text="100%" 
                               Margin="0,0,16,0" 
                               Cursor="Hand"
                               ToolTip="Click to reset zoom (100%)"
                               MouseDown="ResetZoom_Click"
                               Opacity="0.8"/>
                    <Separator Margin="0,0,16,0"/>
                    <TextBlock x:Name="LineEndingStatusText" 
                               Text="Windows (CRLF)" 
                               Margin="0,0,16,0" 
                               Opacity="0.8"/>
                    <Separator Margin="0,0,16,0"/>
                    <TextBlock x:Name="EncodingStatusText" 
                               Text="UTF-8" 
                               Margin="0,0,12,0"
                               Opacity="0.8"/>
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="20" Height="20" Padding="0"
                            ToolTip="Settings (Ctrl+,)"
                            Click="Settings_Click">
                        <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15"/>
                    </Button>
                </StackPanel>

                <!-- Left Side: Position and Counters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LineColStatusText" 
                               Text="Ln 1, Col 1" 
                               Margin="0,0,20,0" 
                               FontWeight="Medium"/>
                    <TextBlock x:Name="WordCharStatusText" 
                               Text="0 words  |  0 chars" 
                               Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Floating Fullscreen Control Bar (Visible in Fullscreen Mode) -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                x:Name="FullscreenControlBar"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,16,0"
                CornerRadius="18"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Padding="6,3"
                Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Exit Fullscreen Button -->
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="Exit Fullscreen (Esc or F11)"
                        Height="30" Padding="10,0"
                        Click="FocusMode_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FullscreenExit" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exit Fullscreen (Esc)" FontWeight="Medium" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Separator Margin="4,4,4,4"/>

                <!-- Minimize Window -->
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Width="28" Height="28" Padding="0"
                        ToolTip="Minimize Window"
                        Click="Minimize_Click">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                </Button>

                <!-- Close Window -->
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Width="28" Height="28" Padding="0"
                        ToolTip="Close Notepad"
                        Click="Exit_Click">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
