<Window x:Class="NotepadByFerryPot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:NotepadByFerryPot.Controls"
        Title="Notepad by FerryPot" 
        Icon="Assets/app.ico"
        Height="720" Width="1080"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar / Menu (Row 0) -->
            <RowDefinition Height="Auto" x:Name="TopAppBarRow"/>
            <!-- Merged Tabs and Formatting Toolbar Bar (Row 1) -->
            <RowDefinition Height="Auto" x:Name="TabsBarRow"/>
            <!-- Editor Body (Row 2) -->
            <RowDefinition Height="*"/>
            <!-- Status Bar (Row 3) -->
            <RowDefinition Height="Auto" x:Name="StatusBarRow"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.Row="0" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="10,4">
                <!-- Action Buttons on Right -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="36" Height="36"
                            ToolTip="Find &amp; Replace (Ctrl+F)"
                            Click="Find_Click">
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="36" Height="36"
                            ToolTip="Document Statistics"
                            Click="Stats_Click">
                        <materialDesign:PackIcon Kind="ChartBoxOutline" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="36" Height="36"
                            ToolTip="Focus / Zen Mode (F11)"
                            Click="FocusMode_Click">
                        <materialDesign:PackIcon Kind="Fullscreen" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Width="36" Height="36"
                            ToolTip="Settings (Ctrl+,)"
                            Click="Settings_Click">
                        <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <!-- Menus & Brand on Left -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Title / Brand -->
                    <StackPanel Orientation="Horizontal" Margin="4,0,8,0" VerticalAlignment="Center">
                        <Image Source="Assets/app.png" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Notepad" 
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" by FerryPot" 
                                   FontSize="13" 
                                   Opacity="0.65" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Subtle Vertical Divider -->
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource MaterialDesignDivider}" Margin="8,0,8,0" VerticalAlignment="Center"/>

                    <!-- Menu Bar -->
                    <Menu Background="Transparent">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New Tab" InputGestureText="Ctrl+N" Click="NewTab_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Plus" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenFile_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAsFile_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentSaveEditOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Print..." InputGestureText="Ctrl+P" Click="Print_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="PrinterOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                            <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
                        </MenuItem>

                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Undo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Redo" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Cu_t" InputGestureText="Ctrl+X" Click="Cut_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCut" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="_Paste" InputGestureText="Ctrl+V" Click="Paste_Click">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentPaste" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Time/_Date" InputGestureText="F5" Click="InsertTimeDate_Click"/>
                        </MenuItem>

                        <MenuItem Header="_View">
                            <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                            <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                            <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="ResetZoom_Click"/>
                            <Separator/>
                            <MenuItem Header="_Syntax View (Raw Markdown)" x:Name="SyntaxViewMenuItem" IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+Shift+M" Click="SyntaxView_Click"/>
                            <MenuItem Header="_Formatted View (Rendered)" x:Name="FormattedViewMenuItem" IsCheckable="True" IsChecked="False" InputGestureText="Ctrl+Shift+P" Click="FormattedView_Click"/>
                            <Separator/>
                            <MenuItem Header="_Formatting Toolbar" x:Name="FormattingToolbarMenuItem" IsCheckable="True" IsChecked="True" Click="FormattingToolbar_Toggle"/>
                            <MenuItem Header="_Word Wrap" x:Name="WordWrapMenuItem" IsCheckable="True" Click="WordWrap_Toggle"/>
                            <MenuItem Header="_Line Numbers" x:Name="LineNumbersMenuItem" IsCheckable="True" Click="LineNumbers_Toggle"/>
                            <MenuItem Header="_Status Bar" x:Name="StatusBarMenuItem" IsCheckable="True" Click="StatusBar_Toggle"/>
                            <Separator/>
                            <MenuItem Header="_Focus / Zen Mode" InputGestureText="F11" Click="FocusMode_Click"/>
                        </MenuItem>

                        <MenuItem Header="_Tools">
                            <MenuItem Header="_Document Statistics" Click="Stats_Click"/>
                            <Separator/>
                            <MenuItem Header="Line Endings">
                                <MenuItem Header="Windows (CRLF)" Click="SetCRLF_Click"/>
                                <MenuItem Header="Unix (LF)" Click="SetLF_Click"/>
                            </MenuItem>
                            <MenuItem Header="Encoding">
                                <MenuItem Header="UTF-8" Click="SetEncodingUTF8_Click"/>
                                <MenuItem Header="UTF-16 LE" Click="SetEncodingUTF16_Click"/>
                                <MenuItem Header="ASCII" Click="SetEncodingASCII_Click"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Merged Tabs and Formatting Toolbar Bar (Row 1) -->
        <Border Grid.Row="1" 
                x:Name="TabsAndToolbarBorder"
                Height="40"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1"
                Padding="6,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Tabs area takes remaining width and scrolls horizontally -->
                    <ColumnDefinition Width="*" />
                    <!-- Thin vertical divider -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Formatting toolbar on right -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: Document Tabs and "+" button -->
                <ScrollViewer Grid.Column="0" 
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" x:Name="TabsStackPanel" VerticalAlignment="Center">
                        <!-- Dynamic Tabs Rendered Here -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                ToolTip="New Document (Ctrl+N)"
                                Width="28" Height="28"
                                Click="NewTab_Click">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Thin Vertical Divider -->
                <Rectangle Grid.Column="1" 
                           x:Name="ToolbarVerticalDivider"
                           Width="1" Height="20" 
                           Fill="{DynamicResource MaterialDesignDivider}" 
                           Margin="8,0,8,0" 
                           VerticalAlignment="Center"/>

                <!-- RIGHT: Formatting Toolbar & Responsive Overflow -->
                <StackPanel Grid.Column="2" 
                            x:Name="FormattingToolbarPanel" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Right">
                    <!-- Full toolbar (visible on wider window) -->
                    <StackPanel Orientation="Horizontal" x:Name="FullToolbarPanel" VerticalAlignment="Center">
                        <!-- Headings Dropdown -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                Padding="6,0" Height="28"
                                ToolTip="Headings"
                                Click="HeadingMenu_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="H1" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="HeadingContextMenu">
                                    <MenuItem Header="H1 — Heading 1 (# )" FontWeight="Bold" FontSize="14" Click="Heading1_Click"/>
                                    <MenuItem Header="H2 — Heading 2 (## )" FontWeight="SemiBold" FontSize="13" Click="Heading2_Click"/>
                                    <MenuItem Header="H3 — Heading 3 (### )" FontWeight="Medium" FontSize="12" Click="Heading3_Click"/>
                                    <MenuItem Header="H4 — Heading 4 (#### )" FontSize="12" Click="Heading4_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Paragraph (Normal Text)" Click="Paragraph_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Lists Dropdown -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                Padding="6,0" Height="28"
                                Margin="2,0,0,0"
                                ToolTip="Lists"
                                Click="ListMenu_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ListContextMenu">
                                    <MenuItem Header="• Bulleted List (- )" Click="BulletList_Click">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FormatListBulleted" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="1. Numbered List (1. )" Click="NumberedList_Click">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FormatListNumbered" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="☑ Task Checklist (- [ ] )" Click="Checklist_Click">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FormatListChecks" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource MaterialDesignDivider}" Margin="6,0,6,0" VerticalAlignment="Center"/>

                        <!-- Bold -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Width="28" Height="28" Padding="0"
                                ToolTip="Bold (Ctrl+B)"
                                Click="Bold_Click">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>

                        <!-- Italic -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Width="28" Height="28" Padding="0"
                                Margin="2,0,0,0"
                                ToolTip="Italic (Ctrl+I)"
                                Click="Italic_Click">
                            <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>

                        <!-- Strikethrough -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Width="28" Height="28" Padding="0"
                                Margin="2,0,0,0"
                                ToolTip="Strikethrough (Ctrl+Shift+S)"
                                Click="Strikethrough_Click">
                            <TextBlock Text="S" TextDecorations="Strikethrough" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource MaterialDesignDivider}" Margin="6,0,6,0" VerticalAlignment="Center"/>

                        <!-- Link -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Width="28" Height="28" Padding="0"
                                ToolTip="Insert Link (Ctrl+K)"
                                Click="Link_Click">
                            <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>

                        <!-- Table Dropdown -->
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                Padding="6,0" Height="28"
                                Margin="2,0,0,0"
                                ToolTip="Insert Markdown Table"
                                Click="TableMenu_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="TableLarge" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource MaterialDesignBody}"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="TableContextMenu">
                                    <MenuItem Header="2 × 2 Table" Click="Table2x2_Click"/>
                                    <MenuItem Header="3 × 3 Table" Click="Table3x3_Click"/>
                                    <MenuItem Header="4 × 4 Table" Click="Table4x4_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource MaterialDesignDivider}" Margin="6,0,6,0" VerticalAlignment="Center"/>

                        <!-- Clear Formatting -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" 
                                Width="28" Height="28" Padding="0"
                                ToolTip="Clear Formatting"
                                Click="ClearFormatting_Click">
                            <materialDesign:PackIcon Kind="FormatClear" Width="16" Height="16" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>
                    </StackPanel>

                    <!-- Compact Overflow Button (Shown when window width is narrow) -->
                    <Button x:Name="OverflowToolbarButton"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="28" Height="28" Padding="0"
                            Visibility="Collapsed"
                            ToolTip="Formatting Tools"
                            Click="OverflowToolbar_Click">
                        <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18" Foreground="{DynamicResource MaterialDesignBody}"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OverflowToolbarContextMenu">
                                <MenuItem Header="Heading 1 (H1)" FontWeight="Bold" Click="Heading1_Click"/>
                                <MenuItem Header="Heading 2 (H2)" FontWeight="SemiBold" Click="Heading2_Click"/>
                                <MenuItem Header="Heading 3 (H3)" FontWeight="Medium" Click="Heading3_Click"/>
                                <MenuItem Header="Paragraph (Normal)" Click="Paragraph_Click"/>
                                <Separator/>
                                <MenuItem Header="Bold (Ctrl+B)" Click="Bold_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="B" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Italic (Ctrl+I)" Click="Italic_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Strikethrough (Ctrl+Shift+S)" Click="Strikethrough_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="S" TextDecorations="Strikethrough" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Bulleted List" Click="BulletList_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FormatListBulleted"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Numbered List" Click="NumberedList_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FormatListNumbered"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Task Checklist" Click="Checklist_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FormatListChecks"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Insert Link (Ctrl+K)" Click="Link_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="LinkVariant"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Insert Table">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="TableLarge"/>
                                    </MenuItem.Icon>
                                    <MenuItem Header="2 × 2 Table" Click="Table2x2_Click"/>
                                    <MenuItem Header="3 × 3 Table" Click="Table3x3_Click"/>
                                    <MenuItem Header="4 × 4 Table" Click="Table4x4_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Clear Formatting" Click="ClearFormatting_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FormatClear"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Editor Content Area (Row 2) -->
        <controls:NotepadEditor Grid.Row="2" x:Name="ActiveEditor" />

        <!-- Status Bar (Row 3) -->
        <Border Grid.Row="3" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="16,4">
            <DockPanel LastChildFill="True">
                <!-- Right Side: Zoom, Line Ending, Encoding, Segmented View Mode Toggle -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomStatusText" 
                               Text="100%" 
                               Margin="0,0,16,0" 
                               Cursor="Hand"
                               ToolTip="Click to reset zoom (100%)"
                               MouseDown="ResetZoom_Click"
                               Opacity="0.8"/>
                    <Separator Margin="0,0,16,0"/>
                    <TextBlock x:Name="LineEndingStatusText" 
                               Text="Windows (CRLF)" 
                               Margin="0,0,16,0" 
                               Opacity="0.8"/>
                    <Separator Margin="0,0,16,0"/>
                    <TextBlock x:Name="EncodingStatusText" 
                               Text="UTF-8" 
                               Margin="0,0,12,0"
                               Opacity="0.8"/>
                    <Separator Margin="0,0,12,0"/>
                    <!-- Status Bar View Mode Button -->
                    <Button x:Name="StatusBarViewModeButton"
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Height="24" Padding="6,0"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            ToolTip="Switch to Markdown syntax (Ctrl+Shift+M)"
                            Click="ToggleViewMode_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon x:Name="StatusBarViewModeIcon" Kind="FormatLetterCase" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock x:Name="StatusBarViewModeText" Text="Formatted" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Left Side: Position and Counters -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LineColStatusText" 
                               Text="Ln 1, Col 1" 
                               Margin="0,0,20,0" 
                               FontWeight="Medium"/>
                    <TextBlock x:Name="WordCharStatusText" 
                               Text="0 words  |  0 chars" 
                               Opacity="0.8"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Floating Fullscreen Control Bar (Visible in Fullscreen Mode) -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                x:Name="FullscreenControlBar"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,16,0"
                CornerRadius="20"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Padding="6,4"
                Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.35" ShadowDepth="3" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Normal View / Restore Down Button -->
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        ToolTip="Restore to Normal View (Esc or F11)"
                        Height="32" Padding="12,0"
                        Foreground="#1C1B1F"
                        Click="FocusMode_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WindowRestore" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Normal View (Esc)" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Separator Margin="8,4"/>

                <!-- Minimize Window -->
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Width="32" Height="32" Padding="0"
                        ToolTip="Minimize Window"
                        Click="Minimize_Click">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18"/>
                </Button>

                <!-- Close Window -->
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Width="32" Height="32" Padding="0"
                        Foreground="#E53935"
                        ToolTip="Close Window"
                        Click="Exit_Click">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
