<UserControl x:Class="NotepadByFerryPot.Controls.NotepadEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" x:Name="LineNumbersColumn" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Line Numbers Gutter -->
        <Border Grid.Column="0" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,1,0"
                Padding="8,8,8,8"
                x:Name="LineNumbersBorder">
            <ScrollViewer x:Name="LineNumbersScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <TextBlock x:Name="LineNumbersTextBlock"
                           Text="1"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Opacity="0.55"
                           TextAlignment="Right"
                           FontFamily="{Binding ElementName=MainTextBox, Path=FontFamily}"
                           FontSize="{Binding ElementName=MainTextBox, Path=FontSize}"
                           LineHeight="{Binding ElementName=MainTextBox, Path=FontSize}"
                           LineStackingStrategy="BlockLineHeight" />
            </ScrollViewer>
        </Border>

        <!-- Main Text Editor -->
        <TextBox Grid.Column="1"
                 x:Name="MainTextBox"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Padding="12,8,12,12"
                 Background="Transparent"
                 Foreground="{DynamicResource MaterialDesignBody}"
                 CaretBrush="{DynamicResource MaterialDesignBody}"
                 SelectionBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                 SelectionOpacity="0.35"
                 SpellCheck.IsEnabled="False"
                 FontFamily="Consolas"
                 FontSize="15"
                 PreviewKeyDown="MainTextBox_PreviewKeyDown"
                 PreviewTextInput="MainTextBox_PreviewTextInput"
                 TextChanged="MainTextBox_TextChanged"
                 SelectionChanged="MainTextBox_SelectionChanged" />
    </Grid>
</UserControl>
